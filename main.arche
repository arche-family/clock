/// Clock, the Arche phone's, written in Arche, as a phone's clock is
/// (arche-os T7, T12): four pages, tabs along the bottom. Alarm: the
/// alarms, a card each, its time and a switch, the next one's time to go
/// at the top, + for a new one; a tap on one opens its time, set by
/// steppers, Save and Delete. Clock: the time, large, the date and the
/// time zone. Stopwatch: its time, Lap and Start, the laps under it.
/// Timer: minutes and seconds, set by steppers or a preset, counted down,
/// paused and resumed; at its end it rings. An app of the page: its taps
/// come as click events, the phone's Back as a back event while an alarm
/// is open. The time is the shell's (now-millis), as the user reads it
/// (utc-offset and time-zone); a frame is asked for as the second turns,
/// and ten times a second while the stopwatch or the timer runs. What it
/// says is in the phone's language (host_api's locale): English, Uzbek or
/// Russian.
///
/// An app of the phone's world (arche:phone, wit/): the alarm due first is
/// set with the phone (alarm's set), which keeps it and rings it at its
/// time itself, as Android's alarm clocks are: the app need not run, and
/// it rings after a restart too, before the PIN opens the user's data.
/// Rung (alarm's next says none), it is off, as a one-time alarm of
/// Android's is, and the next one is set. A phone that will not set it
/// wakes the app at its time instead (background's wake-at), and the app
/// rings it then (alarm's ring: the phone's alarm screen, Snooze and
/// Dismiss); one that will not ring it gets a notification (notify's
/// post). The timer's end wakes the app the same way. The alarms are kept
/// in the app's storage.
import alarm;
import alloc;
import appkit;
import background;
import dom;
import host_api;
import notify;
import std;

const SHEET: str = ".page { display: flex; flex-direction: column; flex-grow: 1; } .next { font-size: 15px; color: var(--kit-muted); padding: 0 24px 16px; margin-top: -8px; } .acard { padding: 0; } .arow { display: flex; flex-direction: row; align-items: center; gap: 12px; padding: 14px 16px 14px 20px; } .atext { display: flex; flex-direction: column; flex-grow: 1; gap: 2px; } .atime { font-size: 40px; font-weight: 300; color: var(--kit-text); line-height: 48px; } .arow.off .atime { color: var(--kit-muted); } .switch { width: 52px; height: 32px; border-radius: 16px; border: 0; padding: 4px; display: flex; flex-direction: row; justify-content: flex-start; align-items: center; background: var(--kit-line); flex-shrink: 0; } .switch.on { justify-content: flex-end; background: var(--kit-accent); } .knob { width: 24px; height: 24px; border-radius: 12px; background: #ffffff; } .face { display: flex; flex-direction: column; align-items: center; padding: 48px 0 0; gap: 8px; } .time { font-size: 64px; font-weight: 300; color: var(--kit-text); } .date { font-size: 17px; font-weight: 500; color: var(--kit-text); } .zone { font-size: 14px; color: var(--kit-muted); } .elapsed { font-size: 60px; font-weight: 300; color: var(--kit-text); text-align: center; padding: 56px 0 24px; } .laps { display: flex; flex-direction: column; margin: 0 16px; } .lap { display: flex; flex-direction: row; justify-content: space-between; padding: 12px 8px; font-size: 16px; color: var(--kit-text); border-bottom: 1px solid var(--kit-line); } .lap .n { color: var(--kit-muted); } .controls { display: flex; flex-direction: row; justify-content: space-evenly; padding: 24px 0 20px; margin-top: auto; } .round { width: 76px; height: 76px; border-radius: 38px; border: 0; padding: 0; display: flex; align-items: center; justify-content: center; font-size: 16px; font-weight: 500; background: var(--kit-card); color: var(--kit-text); } .round.go { background: var(--kit-accent); color: #ffffff; } .round.stop { background: var(--kit-danger); color: #ffffff; } .pick { display: flex; flex-direction: row; justify-content: center; align-items: center; gap: 8px; padding: 32px 0 16px; } .spin { display: flex; flex-direction: column; align-items: center; } .spin .iconbtn { width: 56px; height: 44px; } .val { font-size: 56px; font-weight: 300; color: var(--kit-text); width: 96px; text-align: center; } .colon { font-size: 48px; font-weight: 300; color: var(--kit-muted); } .unit { font-size: 13px; color: var(--kit-muted); } .presets { display: flex; flex-direction: row; justify-content: center; gap: 8px; padding: 8px 16px; } .countdown { font-size: 64px; font-weight: 300; color: var(--kit-text); text-align: center; padding: 72px 0 8px; } .left { font-size: 15px; color: var(--kit-muted); text-align: center; } .head .title { flex-grow: 1; } .drop { margin: 24px auto 0; } .rlabel { font-size: 14px; color: var(--kit-muted); padding: 16px 24px 8px; } .wdays { display: flex; flex-direction: row; justify-content: space-between; padding: 0 20px; } .wday { width: 40px; height: 40px; border-radius: 20px; border: 0; padding: 0; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 500; background: var(--kit-card); color: var(--kit-text); } .wday.on { background: var(--kit-accent); color: #ffffff; } .rsaid { font-size: 14px; color: var(--kit-muted); text-align: center; padding: 12px 24px 0; } .dismiss { margin: 0 16px 14px; align-self: flex-start; } .hidden { display: none; }";

/// Minutes in a day, and ms.
const DAY_MINUTES: i64 = 1440;
const DAY_MS: i64 = 86400000;

/// The pages, as the tabs order them; and the alarm's page, over them.
const ALARMS: u32 = 0;
const CLOCK: u32 = 1;
const WATCH: u32 = 2;
const TIMER: u32 = 3;
const EDIT: u32 = 4;
const PAGES: usize = 5;

/// No alarm: none open, none set with the phone.
const NO: i64 = -1;
/// The alarm open is a new one.
const NEW: i64 = -2;

/// The phone's languages the app speaks.
const EN: u32 = 0;
const UZ: u32 = 1;
const RU: u32 = 2;

/// The language of a locale as the phone says it ("uz-UZ"): English for
/// one the app does not speak.
fn lang_of(locale: str) -> u32 {
    if locale.starts_with("uz") {
        return UZ;
    }
    if locale.starts_with("ru") {
        return RU;
    }
    return EN;
}

/// s, said in English, in lang: s itself in English, and for what the app
/// has no words of.
fn say(lang: u32, s: str) -> str {
    if s.eq("Alarm") {
        if lang == UZ { return "Budilnik"; }
        if lang == RU { return "Будильник"; }
    }
    if s.eq("Clock") {
        if lang == UZ { return "Soat"; }
        if lang == RU { return "Часы"; }
    }
    if s.eq("Stopwatch") {
        if lang == UZ { return "Sekundomer"; }
        if lang == RU { return "Секундомер"; }
    }
    if s.eq("Timer") {
        if lang == UZ { return "Taymer"; }
        if lang == RU { return "Таймер"; }
    }
    if s.eq("Dismiss") {
        if lang == UZ { return "Oʻchirish"; }
        if lang == RU { return "Отключить"; }
    }
    if s.eq("No alarms") {
        if lang == UZ { return "Budilniklar yoʻq"; }
        if lang == RU { return "Нет будильников"; }
    }
    if s.eq("All alarms are off") {
        if lang == UZ { return "Barcha budilniklar oʻchiq"; }
        if lang == RU { return "Все будильники выключены"; }
    }
    if s.eq("Once") {
        if lang == UZ { return "Bir marta"; }
        if lang == RU { return "Один раз"; }
    }
    if s.eq("Every day") {
        if lang == UZ { return "Har kuni"; }
        if lang == RU { return "Каждый день"; }
    }
    if s.eq("Mon to Fri") {
        if lang == UZ { return "Dushanba–juma"; }
        if lang == RU { return "Пн–Пт"; }
    }
    if s.eq("Weekends") {
        if lang == UZ { return "Dam olish kunlari"; }
        if lang == RU { return "Выходные"; }
    }
    if s.eq("Repeat") {
        if lang == UZ { return "Takrorlash"; }
        if lang == RU { return "Повтор"; }
    }
    if s.eq("Add alarm") {
        if lang == UZ { return "Budilnik qoʻshish"; }
        if lang == RU { return "Добавить будильник"; }
    }
    if s.eq("Edit alarm") {
        if lang == UZ { return "Budilnikni tahrirlash"; }
        if lang == RU { return "Изменить будильник"; }
    }
    if s.eq("Delete alarm") {
        if lang == UZ { return "Budilnikni oʻchirish"; }
        if lang == RU { return "Удалить будильник"; }
    }
    if s.eq("Start") {
        if lang == UZ { return "Boshlash"; }
        if lang == RU { return "Старт"; }
    }
    // Short enough for a round button, 76 px across.
    if s.eq("Stop") {
        if lang == UZ { return "Toʻxtat"; }
        if lang == RU { return "Стоп"; }
    }
    if s.eq("Lap") {
        if lang == UZ { return "Davra"; }
        if lang == RU { return "Круг"; }
    }
    if s.eq("Reset") {
        if lang == UZ { return "Tiklash"; }
        if lang == RU { return "Сброс"; }
    }
    if s.eq("Pause") {
        if lang == UZ { return "Pauza"; }
        if lang == RU { return "Пауза"; }
    }
    if s.eq("Resume") {
        if lang == UZ { return "Davom etish"; }
        if lang == RU { return "Старт"; }
    }
    if s.eq("Paused") {
        if lang == UZ { return "Pauzada"; }
        if lang == RU { return "На паузе"; }
    }
    if s.eq("Cancel") {
        if lang == UZ { return "Bekor qilish"; }
        if lang == RU { return "Отмена"; }
    }
    if s.eq("Time's up") {
        if lang == UZ { return "Vaqt tugadi"; }
        if lang == RU { return "Время вышло"; }
    }
    if s.eq("hour") {
        if lang == UZ { return "soat"; }
        if lang == RU { return "час"; }
    }
    if s.eq("min") {
        if lang == UZ { return "daq"; }
        if lang == RU { return "мин"; }
    }
    if s.eq("sec") {
        if lang == UZ { return "son"; }
        if lang == RU { return "сек"; }
    }
    return s;
}

/// n, and after it the Russian noun of its form: one (1, 21), few (2 to 4,
/// 22) or many (5 to 20, 25, 11 to 14).
fn ru_count(out: &mut alloc.String, n: i64, one: str, few: str, many: str) {
    out.push_u64(n as u64);
    out.push_str(" ");
    let units = n % 10;
    let tens = n % 100;
    if units == 1 and tens != 11 {
        out.push_str(one);
    } else if units >= 2 and units <= 4 and (tens < 12 or tens > 14) {
        out.push_str(few);
    } else {
        out.push_str(many);
    }
}

/// An alarm: its time, in minutes of the day as the user reads it, and
/// whether it is on.
/// An alarm: its minute of the day, whether it is on, and the days of the
/// week it rings on (arche-os T12), a bit each from Monday (1) to Sunday
/// (64); none, it rings once and goes off.
type Alarm = struct {
    minute: i64,
    on: bool,
    days: u32,
}

/// Every day, Monday to Friday, and the weekend, as days says them.
const EVERY_DAY: u32 = 127;
const WEEKDAYS: u32 = 31;
const WEEKEND: u32 = 96;

type Clock = struct {
    page: u32,
    /// The alarms, by their time; the one set with the phone (its place),
    /// whether the phone keeps it (alarm's set) or wakes the app for it;
    /// the one open, and the time it is set to there.
    alarms: alloc.List(Alarm),
    armed: i64,
    by_phone: bool,
    open: i64,
    edit_minute: i64,
    edit_days: u32,
    alarms_shown: bool,
    /// The stopwatch: whether it runs, since when (ms), and what it had
    /// counted before that; the laps, in ms from its start.
    running: bool,
    since: i64,
    counted: i64,
    laps: alloc.List(i64),
    laps_shown: usize,
    /// The timer: the seconds it is set to; when it ends (ms), while it
    /// runs; what is left (ms), paused; 0 for neither.
    timer_set: i64,
    timer_end: i64,
    timer_left: i64,
    /// The page's nodes: the pages, the tabs, and what changes on them.
    pages: [5]u32,
    tabs: [4]u32,
    tab_bar: u32,
    fab: u32,
    next: u32,
    dismiss: u32,
    alarm_list: u32,
    empty: u32,
    time: u32,
    date: u32,
    zone: u32,
    elapsed: u32,
    go: u32,
    lap_go: u32,
    lap_list: u32,
    pick_timer: u32,
    countdown: u32,
    left: u32,
    t_min: u32,
    t_sec: u32,
    t_go: u32,
    t_cancel: u32,
    e_title: u32,
    e_hour: u32,
    e_min: u32,
    e_drop: u32,
    e_said: u32,
    /// The phone's locale, as it was last read, and its language; the
    /// stylesheets added, to take back when the page is made again.
    locale: alloc.String,
    lang: u32,
    sheets: [2]u32,
}

fn spin(out: &mut alloc.String, key: str, class: str, unit: str) {
    out.push_str("<div class='spin'><button class='iconbtn' data-k='");
    out.push_str(key);
    out.push_str("+'><span class='icon'>expand_less</span></button><div class='val ");
    out.push_str(class);
    out.push_str("'></div><button class='iconbtn' data-k='");
    out.push_str(key);
    out.push_str("-'><span class='icon'>expand_more</span></button><div class='unit'>");
    out.push_str(unit);
    out.push_str("</div></div>");
}

fn init(host: &mut std.Host, a: alloc.Allocator) -> Clock {
    let kit = appkit.css(a);
    let kit_sheet = dom.add_stylesheet(host, css: kit.view());
    let sheet = dom.add_stylesheet(host, css: SHEET);
    let locale = host_api.locale(host, a: a);
    let lang = lang_of(locale.view());
    var m = alloc.String.from("<div class='app tabbed'><div class='content'>", a);
    m.push_str("<div class='page'><div class='big'>");
    m.push_str(say(lang, s: "Alarm"));
    m.push_str("</div><div class='next'></div><button class='btn dismiss hidden' data-k='dismiss'>");
    m.push_str(say(lang, s: "Dismiss"));
    m.push_str("</button><div class='alarms'></div><div class='empty hidden'><span class='icon'>alarm</span><div>");
    m.push_str(say(lang, s: "No alarms"));
    m.push_str("</div></div></div>");
    m.push_str("<div class='page hidden'><div class='big'>");
    m.push_str(say(lang, s: "Clock"));
    m.push_str("</div><div class='face'><div class='time'></div><div class='date'></div><div class='zone'></div></div></div>");
    m.push_str("<div class='page hidden'><div class='big'>");
    m.push_str(say(lang, s: "Stopwatch"));
    m.push_str("</div><div class='elapsed'></div><div class='laps'></div><div class='controls'><button class='round lapgo' data-k='lap'>");
    m.push_str(say(lang, s: "Reset"));
    m.push_str("</button><button class='round go start' data-k='go'>");
    m.push_str(say(lang, s: "Start"));
    m.push_str("</button></div></div>");
    m.push_str("<div class='page hidden'><div class='big'>");
    m.push_str(say(lang, s: "Timer"));
    m.push_str("</div><div class='pick timerpick'>");
    spin(&mut m, key: "tm", class: "tmin", unit: say(lang, s: "min"));
    m.push_str("<div class='colon'>:</div>");
    spin(&mut m, key: "ts", class: "tsec", unit: say(lang, s: "sec"));
    m.push_str("</div><div class='presets timerpick'><button class='chip' data-k='preset:60'>1 ");
    m.push_str(say(lang, s: "min"));
    m.push_str("</button><button class='chip' data-k='preset:300'>5 ");
    m.push_str(say(lang, s: "min"));
    m.push_str("</button><button class='chip' data-k='preset:600'>10 ");
    m.push_str(say(lang, s: "min"));
    m.push_str("</button><button class='chip' data-k='preset:900'>15 ");
    m.push_str(say(lang, s: "min"));
    m.push_str("</button></div><div class='countdown hidden'></div><div class='left hidden'></div><div class='controls'><button class='round tcancel hidden' data-k='tcancel'>");
    m.push_str(say(lang, s: "Cancel"));
    m.push_str("</button><button class='round go tgo' data-k='tgo'>");
    m.push_str(say(lang, s: "Start"));
    m.push_str("</button></div></div>");
    m.push_str("<div class='page hidden'><div class='head'><button class='iconbtn' data-k='eclose'><span class='icon'>close</span></button><div class='title etitle'>");
    m.push_str(say(lang, s: "Add alarm"));
    m.push_str("</div><button class='iconbtn' data-k='esave'><span class='icon'>check</span></button></div><div class='pick'>");
    spin(&mut m, key: "eh", class: "ehour", unit: say(lang, s: "hour"));
    m.push_str("<div class='colon'>:</div>");
    spin(&mut m, key: "em", class: "emin", unit: say(lang, s: "min"));
    m.push_str("</div><div class='rlabel'>");
    m.push_str(say(lang, s: "Repeat"));
    m.push_str("</div><div class='wdays'>");
    var d: u32 = 0;
    while d < 7 : (d += 1) {
        m.push_str("<button class='wday' data-k='day:");
        m.push_u64(d as u64);
        m.push_str("'>");
        m.push_str(day_letter(lang: lang, d: d));
        m.push_str("</button>");
    }
    m.push_str("</div><div class='rsaid'></div><button class='btn danger drop' data-k='edelete'>");
    m.push_str(say(lang, s: "Delete alarm"));
    m.push_str("</button></div>");
    m.push_str("</div>");
    // The tabs along the bottom, the alarms' marked.
    m.push_str("<div class='tabs'><button class='tab on' data-k='tab:0'><span class='icon'>alarm</span><span>");
    m.push_str(say(lang, s: "Alarm"));
    m.push_str("</span></button><button class='tab' data-k='tab:1'><span class='icon'>schedule</span><span>");
    m.push_str(say(lang, s: "Clock"));
    m.push_str("</span></button><button class='tab' data-k='tab:2'><span class='icon'>timer</span><span>");
    m.push_str(say(lang, s: "Stopwatch"));
    m.push_str("</span></button><button class='tab' data-k='tab:3'><span class='icon'>hourglass_empty</span><span>");
    m.push_str(say(lang, s: "Timer"));
    m.push_str("</span></button></div>");
    m.push_str("<button class='fab' data-k='add'><span class='icon'>add</span></button></div>");
    var why = alloc.String.init(a);
    let root = dom.root(host);
    if not dom.set_markup(host, item: root, markup: m.view(), why: &mut why, a: a) {
        host_api.log(host, msg: why.view());
    }
    let app = first(host, selector: ".app", a: a);
    dom.listen(host, item: app, kind: "click");
    dom.listen(host, item: root, kind: "back");
    // A swipe pages through the tabs, as HyperOS's clock does (arche-os T12).
    dom.listen(host, item: app, kind: "swipe");
    let pages = dom.query_all(host, scope: root, selector: ".page", a: a);
    let tabs = dom.query_all(host, scope: root, selector: ".tab", a: a);
    var state = Clock {
        page: ALARMS,
        alarms: load(host, a: a),
        armed: NO,
        by_phone: false,
        open: NO,
        edit_minute: 420,
        edit_days: 0,
        alarms_shown: false,
        running: false,
        since: 0,
        counted: 0,
        laps: alloc.List(i64).init(a),
        laps_shown: 0,
        timer_set: 300,
        timer_end: 0,
        timer_left: 0,
        pages: [pages.items()[0], pages.items()[1], pages.items()[2], pages.items()[3], pages.items()[4]],
        tabs: [tabs.items()[0], tabs.items()[1], tabs.items()[2], tabs.items()[3]],
        tab_bar: first(host, selector: ".tabs", a: a),
        fab: first(host, selector: ".fab", a: a),
        next: first(host, selector: ".next", a: a),
        dismiss: first(host, selector: ".dismiss", a: a),
        alarm_list: first(host, selector: ".alarms", a: a),
        empty: first(host, selector: ".empty", a: a),
        time: first(host, selector: ".time", a: a),
        date: first(host, selector: ".date", a: a),
        zone: first(host, selector: ".zone", a: a),
        elapsed: first(host, selector: ".elapsed", a: a),
        go: first(host, selector: ".start", a: a),
        lap_go: first(host, selector: ".lapgo", a: a),
        lap_list: first(host, selector: ".laps", a: a),
        pick_timer: first(host, selector: ".timerpick", a: a),
        countdown: first(host, selector: ".countdown", a: a),
        left: first(host, selector: ".left", a: a),
        t_min: first(host, selector: ".tmin", a: a),
        t_sec: first(host, selector: ".tsec", a: a),
        t_go: first(host, selector: ".tgo", a: a),
        t_cancel: first(host, selector: ".tcancel", a: a),
        e_title: first(host, selector: ".etitle", a: a),
        e_hour: first(host, selector: ".ehour", a: a),
        e_min: first(host, selector: ".emin", a: a),
        e_drop: first(host, selector: ".drop", a: a),
        e_said: first(host, selector: ".rsaid", a: a),
        locale: locale,
        lang: lang,
        sheets: [kit_sheet, sheet],
    };
    match host_api.storage_get(host, key: "timer", a: a) {
        some(kept) => {
            // "set end left": what the timer was at when the app last ran.
            state.timer_set = word_number(kept.view(), n: 0);
            state.timer_end = word_number(kept.view(), n: 1);
            state.timer_left = word_number(kept.view(), n: 2);
            if state.timer_set <= 0 {
                state.timer_set = 300;
            }
        }
        none => { }
    }
    // The alarm the phone keeps is the one due first.
    state.armed = soonest(&state, local: local_now(host));
    state.by_phone = has_next(host);
    return state;
}

/// The alarms kept: "420 on,450 off", by their time; one older app's
/// alarm, "420 on" or "420 set", too.
fn load(host: &mut std.Host, a: alloc.Allocator) -> alloc.List(Alarm) {
    var out = alloc.List(Alarm).init(a);
    var text = alloc.String.init(a);
    match host_api.storage_get(host, key: "alarms", a: a) {
        some(kept) => { text = kept; }
        none => {
            match host_api.storage_get(host, key: "alarm", a: a) {
                some(kept) => { text = kept; }
                none => { }
            }
        }
    }
    let b = text.view().bytes();
    var at: usize = 0;
    while at < b.len() {
        var end = at;
        while end < b.len() and b[end] != ',' {
            end += 1;
        }
        let one = text.view()[at..end];
        if one.len() > 0 {
            let minute = number(one) % DAY_MINUTES;
            let on = has_word(s: one, word: "on") or has_word(s: one, word: "set");
            let days = (field_n(one, n: 2) as u32) & EVERY_DAY;
            _ = insert(&mut out, one: Alarm { minute: minute, on: on, days: days });
        }
        at = end + 1;
    }
    return out;
}

/// alarm put among alarms by its time; none of the same time twice.
fn insert(alarms: &mut alloc.List(Alarm), one: Alarm) -> usize {
    var k: usize = 0;
    while k < alarms.len() and alarms.items()[k].minute < one.minute : (k += 1) {
    }
    if k < alarms.len() and alarms.items()[k].minute == one.minute {
        alarms.items_mut()[k].on = one.on;
        return k;
    }
    alarms.push(one);
    var at = alarms.len() - 1;
    while at > k {
        let prev = alarms.items()[at - 1];
        alarms.items_mut()[at] = prev;
        at -= 1;
    }
    alarms.items_mut()[k] = one;
    return k;
}

fn without(alarms: &alloc.List(Alarm), but: usize, a: alloc.Allocator) -> alloc.List(Alarm) {
    var out = alloc.List(Alarm).init(a);
    var k: usize = 0;
    while k < alarms.len() : (k += 1) {
        if k != but {
            out.push(alarms.items()[k]);
        }
    }
    return out;
}

/// The minute of the day local is in, ms since 1970 as the user's clock
/// reads.
fn minute_of(local: i64) -> i64 {
    var m = (local / 60000) % DAY_MINUTES;
    if m < 0 {
        m += DAY_MINUTES;
    }
    return m;
}

/// Whether s ends with tail.
fn ends(s: str, tail: str) -> bool {
    return s.len() >= tail.len() and s[s.len() - tail.len()..s.len()].eq(tail);
}

/// The number s begins with.
fn number(s: str) -> i64 {
    var n: i64 = 0;
    for c in s.bytes() {
        if c.* < '0' or c.* > '9' {
            break;
        }
        n = n * 10 + (c.* - '0') as i64;
    }
    return n;
}

/// The number the n-th word of s, from 0, begins with.
fn word_number(s: str, n: i64) -> i64 {
    let b = s.bytes();
    var at: usize = 0;
    var k: i64 = 0;
    while at < b.len() {
        var e = at;
        while e < b.len() and b[e] != ' ' {
            e += 1;
        }
        if k == n {
            return number(s[at..e]);
        }
        k += 1;
        at = e + 1;
    }
    return 0;
}

/// Now as the user's clock reads it, in ms since 1970.
fn local_now(host: &mut std.Host) -> i64 {
    return host_api.now_millis(host) + host_api.utc_offset(host) as i64 * 60000;
}

/// Whether s has word among its words, parted by spaces.
fn has_word(s: str, word: str) -> bool {
    let b = s.bytes();
    var at: usize = 0;
    while at <= b.len() {
        var e = at;
        while e < b.len() and b[e] != ' ' {
            e += 1;
        }
        if s[at..e].eq(word) {
            return true;
        }
        at = e + 1;
    }
    return false;
}

/// The number the nth of s's words (from 0), parted by spaces, makes; 0
/// for none.
fn field_n(s: str, n: u32) -> i64 {
    let b = s.bytes();
    var at: usize = 0;
    var k: u32 = 0;
    while at < b.len() {
        var e = at;
        while e < b.len() and b[e] != ' ' {
            e += 1;
        }
        if k == n {
            return number(s[at..e]);
        }
        k += 1;
        at = e + 1;
    }
    return 0;
}

/// The day of the week of local (ms since 1970, the user's clock): 0 for
/// Monday to 6 for Sunday; 1970-01-01 was a Thursday.
fn day_of_week(local: i64) -> i64 {
    var day = local / DAY_MS;
    if local < 0 and local % DAY_MS != 0 {
        day -= 1;
    }
    return ((day % 7) + 7 + 3) % 7;
}

/// How long from local until an alarm at minute on days rings, in ms: the
/// next of those days whose minute is still to come; once (no days), today
/// or tomorrow.
fn until_on(minute: i64, days: u32, local: i64) -> i64 {
    if days == 0 {
        return until(minute: minute, local: local);
    }
    var into_day = local % DAY_MS;
    if into_day < 0 {
        into_day += DAY_MS;
    }
    let today = day_of_week(local);
    var k: i64 = 0;
    while k < 8 : (k += 1) {
        let left = k * DAY_MS + minute * 60000 - into_day;
        let wd = (today + k) % 7;
        if left > 0 and (days >> (wd as u32)) & 1 == 1 {
            return left;
        }
    }
    return until(minute: minute, local: local);
}

/// How long from local until minute comes, in ms: today or tomorrow.
fn until(minute: i64, local: i64) -> i64 {
    var into_day = local % DAY_MS;
    if into_day < 0 {
        into_day += DAY_MS;
    }
    var left = minute * 60000 - into_day;
    if left <= 0 {
        left += DAY_MS;
    }
    return left;
}

/// The place of the alarm on that comes first after local; NO for none.
fn soonest(state: &Clock, local: i64) -> i64 {
    var best = NO;
    var best_left: i64 = 0;
    var k: usize = 0;
    while k < state.alarms.len() : (k += 1) {
        let al = state.alarms.items()[k];
        if al.on {
            let left = until_on(minute: al.minute, days: al.days, local: local);
            if best == NO or left < best_left {
                best = k as i64;
                best_left = left;
            }
        }
    }
    return best;
}

/// The alarms kept, and the one due first set with the phone, or else the
/// phone told when to wake the app (for it, or the timer's end, the
/// sooner); none on, both taken back.
fn arm(state: &mut Clock, host: &mut std.Host, a: alloc.Allocator) {
    var kept = alloc.String.init(a);
    for al in state.alarms.items() {
        if kept.len() > 0 {
            kept.push_str(",");
        }
        kept.push_u64(al.minute as u64);
        if al.on {
            kept.push_str(" on");
        } else {
            kept.push_str(" off");
        }
        if al.days != 0 {
            kept.push_str(" ");
            kept.push_u64(al.days as u64);
        }
    }
    var why = alloc.String.init(a);
    if not host_api.storage_set(host, key: "alarms", value: kept.view(), why: &mut why, a: a) {
        host_api.log(host, msg: why.view());
    }
    let now = host_api.now_millis(host);
    let local = local_now(host);
    state.armed = soonest(state, local: local);
    var wake: i64 = 0;
    if state.armed != NO {
        let armed = state.alarms.items()[state.armed as usize];
        let at = now + until_on(minute: armed.minute, days: armed.days, local: local);
        state.by_phone = alarm.set(host, at_millis: at, label: say(state.lang, s: "Alarm"));
        if not state.by_phone {
            wake = at;
        }
    } else {
        state.by_phone = false;
        _ = alarm.set(host, at_millis: 0, label: "");
    }
    if state.timer_end > 0 and (wake == 0 or state.timer_end < wake) {
        wake = state.timer_end;
    }
    background.wake_at(host, at_millis: wake);
}

/// The timer kept: what it is set to, when it ends, what is left.
fn keep_timer(state: &Clock, host: &mut std.Host, a: alloc.Allocator) {
    var kept = alloc.String.init(a);
    kept.push_u64(state.timer_set as u64);
    kept.push_str(" ");
    kept.push_u64(state.timer_end as u64);
    kept.push_str(" ");
    kept.push_u64(state.timer_left as u64);
    var why = alloc.String.init(a);
    if not host_api.storage_set(host, key: "timer", value: kept.view(), why: &mut why, a: a) {
        host_api.log(host, msg: why.view());
    }
}

/// label rings: the phone's alarm screen, or else a notification.
fn ring_now(host: &mut std.Host, label: str, text: str) {
    if not alarm.ring(host, label: label) {
        _ = notify.post(host, title: label, text: text);
    }
}

/// Woken, or the phone having rung the alarm it kept: what was due rings
/// (the timer's end, an alarm the phone did not keep), and the alarm that
/// rang is off, the next one set.
fn due(state: &mut Clock, host: &mut std.Host, woken: bool, a: alloc.Allocator) {
    let now = host_api.now_millis(host);
    if state.timer_end > 0 and now >= state.timer_end {
        state.timer_end = 0;
        state.timer_left = 0;
        keep_timer(state, host: host, a: a);
        ring_now(host, label: say(state.lang, s: "Timer"), text: say(state.lang, s: "Time's up"));
        arm(state, host: host, a: a);
    }
    if state.armed == NO or state.armed as usize >= state.alarms.len() {
        return;
    }
    let rang_by_phone = state.by_phone and not has_next(host);
    if woken and not state.by_phone {
        var text = alloc.String.init(a);
        hours_minutes(state.alarms.items()[state.armed as usize].minute, out: &mut text);
        ring_now(host, label: say(state.lang, s: "Alarm"), text: text.view());
        rang(state, host: host, a: a);
    } else if rang_by_phone {
        rang(state, host: host, a: a);
    }
}

/// The alarm armed has rung: off, if it rings once; else set again, for
/// the next of its days (arche-os T12).
fn rang(state: &mut Clock, host: &mut std.Host, a: alloc.Allocator) {
    let k = state.armed as usize;
    // One that repeats is set again by arm for its next day: its minute
    // has gone today.
    if state.alarms.items()[k].days == 0 {
        state.alarms.items_mut()[k].on = false;
    }
    arm(state, host: host, a: a);
    state.alarms_shown = false;
}

/// Whether the phone keeps an alarm of the app's, not yet rung.
fn has_next(host: &mut std.Host) -> bool {
    match alarm.next(host) {
        some(_) => { return true; }
        none => { return false; }
    }
}

/// When the phone rings the app's snoozed alarm again, in ms since 1970;
/// -1 when it has none.
fn snoozed_until(host: &mut std.Host) -> i64 {
    match alarm.snoozed(host) {
        some(ms) => { return ms; }
        none => { return -1; }
    }
}

/// Minutes of the day as "07:05".
fn hours_minutes(minutes: i64, out: &mut alloc.String) {
    two(out, n: minutes / 60);
    out.push_str(":");
    two(out, n: minutes % 60);
}

/// When ms from now is, in lang, as a clock says it: "in 17 hours 12
/// minutes", "in 5 minutes", "in less than a minute"; "17 soat 12
/// daqiqadan keyin"; "через 17 часов 12 минут".
fn in_said(lang: u32, ms: i64, out: &mut alloc.String) {
    let minutes = (ms + 59999) / 60000;
    // Past a day, its days and hours, as Android says it ("in 2 days 13
    // hours"); else hours and minutes.
    var d = minutes / 1440;
    var h = minutes / 60 % 24;
    var m = minutes % 60;
    if d == 0 {
        h = minutes / 60;
    } else {
        m = 0;
    }
    if lang == UZ {
        // Uzbek's nouns are as they are after any number; the last takes
        // -dan, from, before keyin, after.
        if d == 0 and h == 0 and m == 0 {
            out.push_str("bir daqiqa ichida");
            return;
        }
        var spaced = false;
        if d > 0 {
            out.push_u64(d as u64);
            out.push_str(" kun");
            spaced = true;
        }
        if h > 0 {
            if spaced {
                out.push_str(" ");
            }
            out.push_u64(h as u64);
            out.push_str(" soat");
            spaced = true;
        }
        if m > 0 {
            if spaced {
                out.push_str(" ");
            }
            out.push_u64(m as u64);
            out.push_str(" daqiqa");
        }
        out.push_str("dan keyin");
        return;
    }
    if lang == RU {
        if d == 0 and h == 0 and m == 0 {
            out.push_str("менее чем через минуту");
            return;
        }
        out.push_str("через");
        if d > 0 {
            out.push_str(" ");
            ru_count(out, n: d, one: "день", few: "дня", many: "дней");
        }
        if h > 0 {
            out.push_str(" ");
            ru_count(out, n: h, one: "час", few: "часа", many: "часов");
        }
        if m > 0 {
            out.push_str(" ");
            ru_count(out, n: m, one: "минуту", few: "минуты", many: "минут");
        }
        return;
    }
    if d == 0 and h == 0 and m == 0 {
        out.push_str("in less than a minute");
        return;
    }
    out.push_str("in");
    if d > 0 {
        out.push_str(" ");
        out.push_u64(d as u64);
        if d == 1 {
            out.push_str(" day");
        } else {
            out.push_str(" days");
        }
    }
    if h > 0 {
        out.push_str(" ");
        out.push_u64(h as u64);
        if h == 1 {
            out.push_str(" hour");
        } else {
            out.push_str(" hours");
        }
    }
    if m > 0 {
        out.push_str(" ");
        out.push_u64(m as u64);
        if m == 1 {
            out.push_str(" minute");
        } else {
            out.push_str(" minutes");
        }
    }
}

/// The alarms' page as it is: what rings next, a card an alarm.
fn show_alarms(state: &mut Clock, host: &mut std.Host, local: i64, a: alloc.Allocator) {
    var next = alloc.String.init(a);
    let until_snooze = snoozed_until(host);
    if until_snooze >= 0 {
        // "Snoozed until 07:10", "07:10 gacha kechiktirildi", "Отложен до 07:10".
        var at = alloc.String.init(a);
        hours_minutes(minute_of(until_snooze + host_api.utc_offset(host) as i64 * 60000), out: &mut at);
        if state.lang == UZ {
            next.push_str(at.view());
            next.push_str(" gacha kechiktirildi");
        } else if state.lang == RU {
            next.push_str("Отложен до ");
            next.push_str(at.view());
        } else {
            next.push_str("Snoozed until ");
            next.push_str(at.view());
        }
    } else if state.armed != NO and state.armed as usize < state.alarms.len() {
        next.push_str(say(state.lang, s: "Alarm"));
        next.push_str(" ");
        let armed = state.alarms.items()[state.armed as usize];
        in_said(state.lang, ms: until_on(minute: armed.minute, days: armed.days, local: local), out: &mut next);
    } else if state.alarms.len() > 0 {
        next.push_str(say(state.lang, s: "All alarms are off"));
    }
    dom.set_text(host, item: state.next, text: next.view());
    // Snoozed, Dismiss under it, as the phone's notification has.
    dom.toggle_class(host, item: state.dismiss, name: "hidden", on: until_snooze < 0);
    if state.alarms_shown {
        return;
    }
    state.alarms_shown = true;
    for old in dom.children(host, item: state.alarm_list, a: a).items() {
        dom.release(host, item: old.*);
    }
    dom.toggle_class(host, item: state.empty, name: "hidden", on: state.alarms.len() > 0);
    var k: usize = 0;
    while k < state.alarms.len() : (k += 1) {
        let al = state.alarms.items()[k];
        let card = dom.create_element(host, tag: "div");
        dom.set_attribute(host, item: card, name: "class", value_: "group acard");
        let row = dom.create_element(host, tag: "div");
        if al.on {
            dom.set_attribute(host, item: row, name: "class", value_: "arow");
        } else {
            dom.set_attribute(host, item: row, name: "class", value_: "arow off");
        }
        var key = alloc.String.from("a:", a);
        key.push_u64(k as u64);
        dom.set_attribute(host, item: row, name: "data-k", value_: key.view());
        let text = dom.create_element(host, tag: "div");
        dom.set_attribute(host, item: text, name: "class", value_: "atext");
        var t = alloc.String.init(a);
        hours_minutes(al.minute, out: &mut t);
        line(host, parent_: text, class: "atime", text: t.view(), a: a);
        var under = alloc.String.init(a);
        days_said(lang: state.lang, days: al.days, out: &mut under);
        if al.on {
            under.push_str(" · ");
            in_said(state.lang, ms: until_on(minute: al.minute, days: al.days, local: local), out: &mut under);
        }
        line(host, parent_: text, class: "secondary", text: under.view(), a: a);
        dom.append_child(host, parent_: row, child: text);
        let sw = dom.create_element(host, tag: "button");
        if al.on {
            dom.set_attribute(host, item: sw, name: "class", value_: "switch on");
        } else {
            dom.set_attribute(host, item: sw, name: "class", value_: "switch");
        }
        var tk = alloc.String.from("t:", a);
        tk.push_u64(k as u64);
        dom.set_attribute(host, item: sw, name: "data-k", value_: tk.view());
        // Its name, as a screen reader says it: what a tap does.
        var label = alloc.String.init(a);
        switch_label(state.lang, on: al.on, time: t.view(), out: &mut label);
        dom.set_attribute(host, item: sw, name: "aria-label", value_: label.view());
        let knob = dom.create_element(host, tag: "span");
        dom.set_attribute(host, item: knob, name: "class", value_: "knob");
        dom.append_child(host, parent_: sw, child: knob);
        dom.append_child(host, parent_: row, child: sw);
        dom.append_child(host, parent_: card, child: row);
        dom.append_child(host, parent_: state.alarm_list, child: card);
    }
}

/// The name of an alarm's switch, what a tap on it does: "Turn on 07:00",
/// "07:00 budilnigini yoqish", "Включить будильник на 07:00"; off, when on
/// is.
fn switch_label(lang: u32, on: bool, time: str, out: &mut alloc.String) {
    if lang == UZ {
        out.push_str(time);
        if on {
            out.push_str(" budilnigini oʻchirish");
        } else {
            out.push_str(" budilnigini yoqish");
        }
        return;
    }
    if lang == RU {
        if on {
            out.push_str("Выключить будильник на ");
        } else {
            out.push_str("Включить будильник на ");
        }
        out.push_str(time);
        return;
    }
    if on {
        out.push_str("Turn off ");
    } else {
        out.push_str("Turn on ");
    }
    out.push_str(time);
}

/// A div of class with text, last under parent_.
fn line(host: &mut std.Host, parent_: u32, class: str, text: str, a: alloc.Allocator) {
    let d = dom.create_element(host, tag: "div");
    dom.set_attribute(host, item: d, name: "class", value_: class);
    dom.set_text(host, item: d, text: text);
    dom.append_child(host, parent_: parent_, child: d);
}

/// The first node under the page that selector finds; 0 for none.
fn first(host: &mut std.Host, selector: str, a: alloc.Allocator) -> u32 {
    let found = dom.query_all(host, scope: dom.root(host), selector: selector, a: a);
    if found.len() == 0 {
        return 0;
    }
    return found.items()[0];
}

/// The key a click on n is: its data-k, or its nearest ancestor's.
fn key_of(host: &mut std.Host, n: u32, a: alloc.Allocator) -> ?alloc.String {
    var at = n;
    var hops: u32 = 0;
    while at != 0 and hops < 8 : (hops += 1) {
        match dom.get_attribute(host, item: at, name: "data-k", a: a) {
            some(k) => { return k; }
            none => { }
        }
        at = dom.parent(host, item: at) orelse 0;
    }
    return none;
}

/// What the stopwatch shows at now, in ms.
fn counted(state: &Clock, now: i64) -> i64 {
    if state.running {
        return state.counted + now - state.since;
    }
    return state.counted;
}

/// What is left of the timer at now, in ms; 0 when it is not set going.
fn timer_left(state: &Clock, now: i64) -> i64 {
    if state.timer_end > 0 {
        let left = state.timer_end - now;
        if left < 0 {
            return 0;
        }
        return left;
    }
    return state.timer_left;
}

/// The page shown, its tab marked; the + only on the alarms'; Back the
/// page's while an alarm is open.
fn go_to(state: &mut Clock, host: &mut std.Host, page: u32) {
    state.page = page;
    var k: usize = 0;
    while k < PAGES : (k += 1) {
        dom.toggle_class(host, item: state.pages[k], name: "hidden", on: k as u32 != page);
    }
    k = 0;
    while k < 4 : (k += 1) {
        dom.toggle_class(host, item: state.tabs[k], name: "on", on: k as u32 == page);
    }
    dom.toggle_class(host, item: state.fab, name: "hidden", on: page != ALARMS);
    dom.toggle_class(host, item: state.tab_bar, name: "hidden", on: page == EDIT);
    if page == EDIT {
        dom.set_attribute(host, item: dom.root(host), name: "data-back", value_: "1");
    } else {
        dom.remove_attribute(host, item: dom.root(host), name: "data-back");
    }
}

fn update(state: &mut Clock, host: &mut std.Host, a: alloc.Allocator) {
    // The phone's language changed: the page made again in it, as init
    // makes it, its stylesheets taken back first, on the alarms' page. What
    // was on it is lost, the stopwatch too; the alarms and the timer are
    // kept.
    let locale = host_api.locale(host, a: a);
    if not locale.view().eq(state.locale.view()) {
        dom.remove_stylesheet(host, sheet: state.sheets[0]);
        dom.remove_stylesheet(host, sheet: state.sheets[1]);
        state.* = init(host, a: a);
        go_to(state, host: host, page: ALARMS);
    }
    let now = host_api.now_millis(host);
    due(state, host: host, woken: background.woken(host), a: a);
    for e in dom.events(host, a: a).items() {
        if e.kind.view().eq("back") {
            press(state, host: host, key: "eclose", now: now, a: a);
        } else if e.kind.view().eq("swipe") and state.page < EDIT {
            if e.value.view().eq("left") and state.page < TIMER {
                go_to(state, host: host, page: state.page + 1);
            } else if e.value.view().eq("right") and state.page > ALARMS {
                go_to(state, host: host, page: state.page - 1);
            }
        } else if e.kind.view().eq("click") {
            match key_of(host, n: e.target, a: a) {
                some(k) => { press(state, host: host, key: k.view(), now: now, a: a); }
                none => { }
            }
        }
    }
    let offset = host_api.utc_offset(host) as i64;
    let local = now + offset * 60000;
    show_alarms(state, host: host, local: local, a: a);
    // The clock's page: the time as the user reads it.
    var time = alloc.String.init(a);
    clock_text(local, out: &mut time);
    dom.set_text(host, item: state.time, text: time.view());
    var date = alloc.String.init(a);
    date_text(state.lang, local: local, out: &mut date);
    dom.set_text(host, item: state.date, text: date.view());
    var zone = alloc.String.init(a);
    let name = host_api.time_zone(host, a: a);
    if name.len() > 0 {
        zone.push_str(name.view());
        zone.push_str(" · ");
    }
    zone.push_str("UTC");
    if offset < 0 {
        zone.push_str("−");
    } else {
        zone.push_str("+");
    }
    var off = offset;
    if off < 0 {
        off = 0 - off;
    }
    two(&mut zone, n: off / 60);
    zone.push_str(":");
    two(&mut zone, n: off % 60);
    dom.set_text(host, item: state.zone, text: zone.view());
    // The stopwatch, and its laps not shown yet, the latest first.
    var shown = alloc.String.init(a);
    watch_text(counted(state, now: now), out: &mut shown);
    dom.set_text(host, item: state.elapsed, text: shown.view());
    if state.running {
        dom.set_text(host, item: state.go, text: say(state.lang, s: "Stop"));
        dom.toggle_class(host, item: state.go, name: "stop", on: true);
        dom.set_text(host, item: state.lap_go, text: say(state.lang, s: "Lap"));
    } else {
        dom.set_text(host, item: state.go, text: say(state.lang, s: "Start"));
        dom.toggle_class(host, item: state.go, name: "stop", on: false);
        dom.set_text(host, item: state.lap_go, text: say(state.lang, s: "Reset"));
    }
    while state.laps_shown < state.laps.len() {
        let k = state.laps_shown;
        var previous: i64 = 0;
        if k > 0 {
            previous = state.laps.items()[k - 1];
        }
        let row = dom.create_element(host, tag: "div");
        dom.set_attribute(host, item: row, name: "class", value_: "lap");
        var n = alloc.String.from(say(state.lang, s: "Lap"), a);
        n.push_str(" ");
        n.push_u64((k + 1) as u64);
        let name_span = dom.create_element(host, tag: "span");
        dom.set_attribute(host, item: name_span, name: "class", value_: "n");
        dom.set_text(host, item: name_span, text: n.view());
        dom.append_child(host, parent_: row, child: name_span);
        var split = alloc.String.init(a);
        watch_text(state.laps.items()[k] - previous, out: &mut split);
        let split_span = dom.create_element(host, tag: "span");
        dom.set_text(host, item: split_span, text: split.view());
        dom.append_child(host, parent_: row, child: split_span);
        var total = alloc.String.init(a);
        watch_text(state.laps.items()[k], out: &mut total);
        let total_span = dom.create_element(host, tag: "span");
        dom.set_text(host, item: total_span, text: total.view());
        dom.append_child(host, parent_: row, child: total_span);
        let rows = dom.children(host, item: state.lap_list, a: a);
        if rows.len() > 0 {
            dom.insert_before(host, parent_: state.lap_list, child: row, before: rows.items()[0]);
        } else {
            dom.append_child(host, parent_: state.lap_list, child: row);
        }
        state.laps_shown += 1;
    }
    // The timer: set, or counting down.
    let left = timer_left(state, now: now);
    let going = state.timer_end > 0;
    let set_going = going or state.timer_left > 0;
    var tm = alloc.String.init(a);
    two(&mut tm, n: state.timer_set / 60);
    dom.set_text(host, item: state.t_min, text: tm.view());
    var ts = alloc.String.init(a);
    two(&mut ts, n: state.timer_set % 60);
    dom.set_text(host, item: state.t_sec, text: ts.view());
    var cd = alloc.String.init(a);
    countdown_text((left + 999) / 1000, out: &mut cd);
    dom.set_text(host, item: state.countdown, text: cd.view());
    for p in dom.query_all(host, scope: dom.root(host), selector: ".timerpick", a: a).items() {
        dom.toggle_class(host, item: p.*, name: "hidden", on: set_going);
    }
    dom.toggle_class(host, item: state.countdown, name: "hidden", on: not set_going);
    dom.toggle_class(host, item: state.left, name: "hidden", on: not set_going);
    dom.toggle_class(host, item: state.t_cancel, name: "hidden", on: not set_going);
    if going {
        dom.set_text(host, item: state.t_go, text: say(state.lang, s: "Pause"));
        dom.set_text(host, item: state.left, text: "");
    } else if set_going {
        dom.set_text(host, item: state.t_go, text: say(state.lang, s: "Resume"));
        dom.set_text(host, item: state.left, text: say(state.lang, s: "Paused"));
    } else {
        dom.set_text(host, item: state.t_go, text: say(state.lang, s: "Start"));
    }
    // The next frame: in a tenth of a second while something runs; else as
    // the second turns.
    if state.running or going {
        host_api.request_frame(host, after_ms: 100);
    } else {
        host_api.request_frame(host, after_ms: (1000 - local % 1000) as u32);
    }
}

fn press(state: &mut Clock, host: &mut std.Host, key: str, now: i64, a: alloc.Allocator) {
    if key.starts_with("tab:") {
        go_to(state, host: host, page: number(key[4..key.len()]) as u32);
    } else if key.eq("add") {
        state.open = NEW;
        // A new alarm at seven, as a phone's offers.
        state.edit_minute = 420;
        state.edit_days = 0;
        dom.set_text(host, item: state.e_title, text: say(state.lang, s: "Add alarm"));
        dom.toggle_class(host, item: state.e_drop, name: "hidden", on: true);
        show_edit(state, host: host, a: a);
        go_to(state, host: host, page: EDIT);
    } else if key.starts_with("a:") {
        let k = number(key[2..key.len()]);
        if k >= 0 and (k as usize) < state.alarms.len() {
            state.open = k;
            state.edit_minute = state.alarms.items()[k as usize].minute;
            state.edit_days = state.alarms.items()[k as usize].days;
            dom.set_text(host, item: state.e_title, text: say(state.lang, s: "Edit alarm"));
            dom.toggle_class(host, item: state.e_drop, name: "hidden", on: false);
            show_edit(state, host: host, a: a);
            go_to(state, host: host, page: EDIT);
        }
    } else if key.starts_with("t:") {
        let k = number(key[2..key.len()]);
        if k >= 0 and (k as usize) < state.alarms.len() {
            if snoozed_until(host) >= 0 and k == state.armed {
                alarm.dismiss(host);
            }
            let on = state.alarms.items()[k as usize].on;
            state.alarms.items_mut()[k as usize].on = not on;
            arm(state, host: host, a: a);
            state.alarms_shown = false;
        }
    } else if key.eq("dismiss") {
        alarm.dismiss(host);
    } else if key.eq("eclose") {
        state.open = NO;
        go_to(state, host: host, page: ALARMS);
    } else if key.eq("esave") {
        if state.open >= 0 and (state.open as usize) < state.alarms.len() {
            state.alarms = without(&state.alarms, but: state.open as usize, a: a);
        }
        _ = insert(&mut state.alarms, one: Alarm { minute: state.edit_minute, on: true, days: state.edit_days });
        state.open = NO;
        arm(state, host: host, a: a);
        state.alarms_shown = false;
        go_to(state, host: host, page: ALARMS);
    } else if key.eq("edelete") {
        if state.open >= 0 and (state.open as usize) < state.alarms.len() {
            state.alarms = without(&state.alarms, but: state.open as usize, a: a);
        }
        state.open = NO;
        arm(state, host: host, a: a);
        state.alarms_shown = false;
        go_to(state, host: host, page: ALARMS);
    } else if key.starts_with("day:") {
        // A day of the week on or off for the alarm being edited.
        let d = number(key[4..key.len()]);
        if d >= 0 and d < 7 {
            let bit: u32 = 1;
            state.edit_days = state.edit_days ^ (bit << (d as u32));
            show_edit(state, host: host, a: a);
        }
    } else if key.eq("eh+") or key.eq("eh-") or key.eq("em+") or key.eq("em-") {
        var step: i64 = 1;
        if key.bytes()[1] == 'h' {
            step = 60;
        }
        if key.bytes()[2] == '-' {
            step = DAY_MINUTES - step;
        }
        state.edit_minute = (state.edit_minute + step) % DAY_MINUTES;
        show_edit(state, host: host, a: a);
    } else if key.eq("go") {
        if state.running {
            state.counted = counted(state, now: now);
            state.running = false;
        } else {
            state.since = now;
            state.running = true;
        }
    } else if key.eq("lap") {
        if state.running {
            state.laps.push(counted(state, now: now));
        } else {
            state.counted = 0;
            state.laps = alloc.List(i64).init(a);
            state.laps_shown = 0;
            for row in dom.children(host, item: state.lap_list, a: a).items() {
                dom.release(host, item: row.*);
            }
        }
    } else if key.eq("tm+") or key.eq("tm-") or key.eq("ts+") or key.eq("ts-") {
        var step: i64 = 1;
        if key.bytes()[1] == 'm' {
            step = 60;
        }
        var set = state.timer_set;
        if key.bytes()[2] == '-' {
            set -= step;
        } else {
            set += step;
        }
        if set < 1 {
            set = 1;
        }
        if set > 99 * 60 + 59 {
            set = 99 * 60 + 59;
        }
        state.timer_set = set;
        keep_timer(state, host: host, a: a);
    } else if key.starts_with("preset:") {
        state.timer_set = number(key[7..key.len()]);
        keep_timer(state, host: host, a: a);
    } else if key.eq("tgo") {
        if state.timer_end > 0 {
            // Paused: what is left kept.
            state.timer_left = timer_left(state, now: now);
            state.timer_end = 0;
        } else if state.timer_left > 0 {
            state.timer_end = now + state.timer_left;
            state.timer_left = 0;
        } else {
            state.timer_end = now + state.timer_set * 1000;
        }
        keep_timer(state, host: host, a: a);
        arm(state, host: host, a: a);
    } else if key.eq("tcancel") {
        state.timer_end = 0;
        state.timer_left = 0;
        keep_timer(state, host: host, a: a);
        arm(state, host: host, a: a);
    }
}

/// The alarm's page: its time on the steppers.
fn show_edit(state: &Clock, host: &mut std.Host, a: alloc.Allocator) {
    var h = alloc.String.init(a);
    two(&mut h, n: state.edit_minute / 60);
    dom.set_text(host, item: state.e_hour, text: h.view());
    var m = alloc.String.init(a);
    two(&mut m, n: state.edit_minute % 60);
    dom.set_text(host, item: state.e_min, text: m.view());
    // The days it rings on marked, and said.
    let days = dom.query_all(host, scope: dom.root(host), selector: ".wday", a: a);
    var d: usize = 0;
    while d < days.len() : (d += 1) {
        dom.toggle_class(host, item: days.items()[d], name: "on", on: (state.edit_days >> (d as u32)) & 1 == 1);
    }
    var said = alloc.String.init(a);
    days_said(lang: state.lang, days: state.edit_days, out: &mut said);
    dom.set_text(host, item: state.e_said, text: said.view());
}

/// A day's letters on its button, Monday (0) to Sunday (6), in lang.
fn day_letter(lang: u32, d: u32) -> str {
    if lang == UZ {
        if d == 0 { return "Du"; }
        if d == 1 { return "Se"; }
        if d == 2 { return "Ch"; }
        if d == 3 { return "Pa"; }
        if d == 4 { return "Ju"; }
        if d == 5 { return "Sh"; }
        return "Ya";
    }
    if lang == RU {
        if d == 0 { return "Пн"; }
        if d == 1 { return "Вт"; }
        if d == 2 { return "Ср"; }
        if d == 3 { return "Чт"; }
        if d == 4 { return "Пт"; }
        if d == 5 { return "Сб"; }
        return "Вс";
    }
    if d == 0 { return "M"; }
    if d == 1 { return "T"; }
    if d == 2 { return "W"; }
    if d == 3 { return "T"; }
    if d == 4 { return "F"; }
    if d == 5 { return "S"; }
    return "S";
}

/// A day's short name, Monday (0) to Sunday (6), in lang.
fn day_short(lang: u32, d: u32) -> str {
    if lang == UZ {
        return day_letter(lang: lang, d: d);
    }
    if lang == RU {
        return day_letter(lang: lang, d: d);
    }
    if d == 0 { return "Mon"; }
    if d == 1 { return "Tue"; }
    if d == 2 { return "Wed"; }
    if d == 3 { return "Thu"; }
    if d == 4 { return "Fri"; }
    if d == 5 { return "Sat"; }
    return "Sun";
}

/// When an alarm on days rings, as a phone says it: Once, Every day, Mon
/// to Fri, Weekends, or its days ("Mon, Wed, Fri"), into out.
fn days_said(lang: u32, days: u32, out: &mut alloc.String) {
    if days == 0 {
        out.push_str(say(lang, s: "Once"));
        return;
    }
    if days == EVERY_DAY {
        out.push_str(say(lang, s: "Every day"));
        return;
    }
    if days == WEEKDAYS {
        out.push_str(say(lang, s: "Mon to Fri"));
        return;
    }
    if days == WEEKEND {
        out.push_str(say(lang, s: "Weekends"));
        return;
    }
    var lead = true;
    var d: u32 = 0;
    while d < 7 : (d += 1) {
        if (days >> d) & 1 == 1 {
            if not lead {
                out.push_str(", ");
            }
            out.push_str(day_short(lang: lang, d: d));
            lead = false;
        }
    }
}

fn two(s: &mut alloc.String, n: i64) {
    if n < 10 {
        s.push_str("0");
    }
    s.push_u64(n as u64);
}

/// Hours, minutes and seconds of local, ms since 1970 as the user's
/// clock reads.
fn clock_text(local: i64, out: &mut alloc.String) {
    var seconds = (local / 1000) % 86400;
    if seconds < 0 {
        seconds += 86400;
    }
    two(out, n: seconds / 3600);
    out.push_str(":");
    two(out, n: (seconds / 60) % 60);
    out.push_str(":");
    two(out, n: seconds % 60);
}

/// The n-th word of words, from 0.
fn nth_word(words: str, n: i64) -> str {
    let b = words.bytes();
    var at: usize = 0;
    var k: i64 = 0;
    while at < b.len() {
        var e = at;
        while e < b.len() and b[e] != ' ' {
            e += 1;
        }
        if k == n {
            return words[at..e];
        }
        k += 1;
        at = e + 1;
    }
    return "";
}

/// The days' names in Uzbek and Russian, from Thursday; and the months',
/// as a date says them after the day (in Russian, genitive).
const UZ_DAYS: str = "Payshanba Juma Shanba Yakshanba Dushanba Seshanba Chorshanba";
const RU_DAYS: str = "Четверг Пятница Суббота Воскресенье Понедельник Вторник Среда";
const UZ_MONTHS: str = "yanvar fevral mart aprel may iyun iyul avgust sentabr oktabr noyabr dekabr";
const RU_MONTHS: str = "января февраля марта апреля мая июня июля августа сентября октября ноября декабря";

/// The day of local, in lang: "Tuesday, November 10", "Seshanba,
/// 10-noyabr", "Вторник, 10 ноября".
fn date_text(lang: u32, local: i64, out: &mut alloc.String) {
    var days = local / 86400000;
    if local < 0 and local % 86400000 != 0 {
        days -= 1;
    }
    // The civil date from the days since 1970 (Howard Hinnant's
    // civil_from_days).
    let z = days + 719468;
    var era = z / 146097;
    if z < 0 {
        era = (z - 146096) / 146097;
    }
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let day = doy - (153 * mp + 2) / 5 + 1;
    var month = mp + 3;
    if mp >= 10 {
        month = mp - 9;
    }
    // 1970-01-01 was a Thursday.
    var weekday = days % 7;
    if weekday < 0 {
        weekday += 7;
    }
    if lang == UZ {
        out.push_str(nth_word(UZ_DAYS, n: weekday));
        out.push_str(", ");
        out.push_u64(day as u64);
        out.push_str("-");
        out.push_str(nth_word(UZ_MONTHS, n: month - 1));
        return;
    }
    if lang == RU {
        out.push_str(nth_word(RU_DAYS, n: weekday));
        out.push_str(", ");
        out.push_u64(day as u64);
        out.push_str(" ");
        out.push_str(nth_word(RU_MONTHS, n: month - 1));
        return;
    }
    out.push_str(nth_word("Thursday Friday Saturday Sunday Monday Tuesday Wednesday", n: weekday));
    out.push_str(", ");
    out.push_str(nth_word("January February March April May June July August September October November December", n: month - 1));
    out.push_str(" ");
    out.push_u64(day as u64);
}

/// A stopwatch's ms as minutes, seconds and hundredths: "01:23.45".
fn watch_text(ms: i64, out: &mut alloc.String) {
    var m = ms;
    if m < 0 {
        m = 0;
    }
    two(out, n: m / 60000);
    out.push_str(":");
    two(out, n: (m / 1000) % 60);
    out.push_str(".");
    two(out, n: (m / 10) % 100);
}

/// A timer's seconds left as "04:59", or "1:04:59" past an hour.
fn countdown_text(seconds: i64, out: &mut alloc.String) {
    if seconds >= 3600 {
        out.push_u64((seconds / 3600) as u64);
        out.push_str(":");
    }
    two(out, n: (seconds / 60) % 60);
    out.push_str(":");
    two(out, n: seconds % 60);
}
