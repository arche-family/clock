/// Clock, the Arche phone's, written in Arche, as Android's: the time,
/// large, the date and the time zone under it, an alarm, and a stopwatch
/// with its laps. An app of the page: its buttons' taps come as click
/// events. The time is the shell's (now-millis), as the user reads it
/// (utc-offset and time-zone); a frame is asked for as the second turns,
/// and ten times a second while the stopwatch runs.
///
/// An app of the phone's world (arche:phone, wit/): the alarm, once on, is
/// set with the phone (alarm's set), which keeps it and rings it at its
/// time itself, as Android's alarm clocks are: the app need not run, and
/// it rings after a restart too, before the PIN opens the user's data.
/// Rung (alarm's next says none), it is off, as a one-time alarm of
/// Android's is. A phone that will not set it wakes the app at its time
/// instead (background's wake-at), off the screen or asleep, and the app
/// rings it then (alarm's ring: the phone's alarm screen, Snooze and
/// Dismiss, its sound until one is tapped, in Do Not Disturb too); one that
/// will not ring it gets a notification (notify's post). Snoozed, the card
/// says until when, and Dismiss ends it. Its time, whether it is on, and
/// how, are kept in the app's storage.
import alarm;
import alloc;
import background;
import dom;
import host_api;
import notify;
import std;

const SHEET: str = "body { padding: 0; } .clock { display: flex; flex-direction: column; gap: 16px; padding: 16px; } .face { display: flex; flex-direction: column; align-items: center; padding-top: 48px; padding-bottom: 24px; gap: 6px; } .time { font-size: 64px; color: var(--nimadir-text); } .date { font-size: 18px; color: var(--nimadir-text); } .zone { font-size: 14px; color: var(--nimadir-muted); } .watch { display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 20px; border-radius: 24px; background: var(--nimadir-surface); } .title { font-size: 16px; color: var(--nimadir-muted); } .elapsed { font-size: 44px; color: var(--nimadir-text); } .buttons { display: flex; flex-direction: row; gap: 12px; } button { padding: 12px 24px; border-radius: 24px; font-size: 16px; border: 0; background: var(--nimadir-accent-wash); color: var(--nimadir-text); } button.go { background: var(--nimadir-accent); color: var(--nimadir-bg); } .laps { display: flex; flex-direction: column; gap: 4px; } .lap { font-size: 15px; color: var(--nimadir-muted); } .alarm { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 20px; border-radius: 24px; background: var(--nimadir-surface); } .set { font-size: 44px; color: var(--nimadir-text); } .rings { font-size: 15px; color: var(--nimadir-muted); } .alarm button { padding: 10px 14px; } .alarm button.go { padding: 12px 24px; }";

/// Minutes in a day, and ms.
const DAY_MINUTES: i64 = 1440;
const DAY_MS: i64 = 86400000;

type Clock = struct {
    /// The stopwatch: whether it runs, since when (ms), and what it had
    /// counted before that; the laps, in ms from its start.
    running: bool,
    since: i64,
    counted: i64,
    laps: alloc.List(i64),
    laps_shown: usize,
    /// The page's nodes.
    time: u32,
    date: u32,
    zone: u32,
    elapsed: u32,
    go: u32,
    lap_list: u32,
    /// The alarm: its time, in minutes of the day as the user reads it,
    /// whether it is on, and whether the phone keeps it (alarm's set) or
    /// wakes the app for it; its nodes.
    alarm_at: i64,
    alarm_on: bool,
    by_phone: bool,
    alarm_set: u32,
    alarm_rings: u32,
    alarm_go: u32,
}

fn init(host: &mut std.Host, a: alloc.Allocator) -> Clock {
    _ = dom.add_stylesheet(host, css: SHEET);
    let root = dom.root(host);
    let markup = "<div class='clock'><div class='face'><div class='time'></div><div class='date'></div><div class='zone'></div></div><div class='alarm'><div class='title'>Alarm</div><div class='set'></div><div class='buttons'><button data-k='h-'>−1 h</button><button data-k='h+'>+1 h</button><button data-k='m-'>−1 min</button><button data-k='m+'>+1 min</button></div><div class='rings'></div><button class='go turn' data-k='alarm'></button></div><div class='watch'><div class='title'>Stopwatch</div><div class='elapsed'></div><div class='buttons'><button class='go start' data-k='go'>Start</button><button data-k='lap'>Lap</button><button data-k='reset'>Reset</button></div><div class='laps'></div></div></div>";
    var why = alloc.String.init(a);
    if not dom.set_markup(host, item: root, markup: markup, why: &mut why, a: a) {
        host_api.log(host, msg: why.view());
    }
    let clock = first(host, selector: ".clock", a: a);
    dom.listen(host, item: clock, kind: "click");
    // The alarm kept; none yet, the time now, as Android's picker starts.
    let now = host_api.now_millis(host);
    var at = minute_of(now + host_api.utc_offset(host) as i64 * 60000);
    var alarm_on = false;
    var by_phone = false;
    match host_api.storage_get(host, key: "alarm", a: a) {
        some(kept) => {
            let k = kept.view();
            at = number(k) % DAY_MINUTES;
            // "420 on", woken for it; "420 set", the phone keeps it.
            alarm_on = ends(s: k, tail: " on") or ends(s: k, tail: " set");
            by_phone = ends(s: k, tail: " set");
        }
        none => { }
    }
    return Clock {
        running: false,
        since: 0,
        counted: 0,
        laps: alloc.List(i64).init(a),
        laps_shown: 0,
        time: first(host, selector: ".time", a: a),
        date: first(host, selector: ".date", a: a),
        zone: first(host, selector: ".zone", a: a),
        elapsed: first(host, selector: ".elapsed", a: a),
        go: first(host, selector: ".start", a: a),
        lap_list: first(host, selector: ".laps", a: a),
        alarm_at: at,
        alarm_on: alarm_on,
        by_phone: by_phone,
        alarm_set: first(host, selector: ".set", a: a),
        alarm_rings: first(host, selector: ".rings", a: a),
        alarm_go: first(host, selector: ".turn", a: a),
    };
}

/// The minute of the day local is in, ms since 1970 as the user's clock
/// reads.
fn minute_of(local: i64) -> i64 {
    var m = (local / 60000) % DAY_MINUTES;
    if m < 0 {
        m += DAY_MINUTES;
    }
    return m;
}

/// Whether s ends with tail.
fn ends(s: str, tail: str) -> bool {
    return s.len() >= tail.len() and s[s.len() - tail.len()..s.len()].eq(tail);
}

/// The number s begins with.
fn number(s: str) -> i64 {
    var n: i64 = 0;
    for c in s.bytes() {
        if c.* < '0' or c.* > '9' {
            break;
        }
        n = n * 10 + (c.* - '0') as i64;
    }
    return n;
}

/// How long from now until the alarm rings, in ms: its next time, today
/// or tomorrow.
fn until_alarm(state: &Clock, local: i64) -> i64 {
    var into_day = local % DAY_MS;
    if into_day < 0 {
        into_day += DAY_MS;
    }
    var left = state.alarm_at * 60000 - into_day;
    if left <= 0 {
        left += DAY_MS;
    }
    return left;
}

/// The alarm kept, and, while it is on, set with the phone, or else the
/// phone told when to wake the app; off, both taken back.
fn arm(state: &mut Clock, host: &mut std.Host, now: i64, a: alloc.Allocator) {
    var kept = alloc.String.init(a);
    kept.push_u64(state.alarm_at as u64);
    if state.alarm_on {
        let local = now + host_api.utc_offset(host) as i64 * 60000;
        let at = now + until_alarm(state, local: local);
        state.by_phone = alarm.set(host, at_millis: at, label: "Alarm");
        if state.by_phone {
            kept.push_str(" set");
            background.wake_at(host, at_millis: 0);
        } else {
            kept.push_str(" on");
            background.wake_at(host, at_millis: at);
        }
    } else {
        kept.push_str(" off");
        _ = alarm.set(host, at_millis: 0, label: "");
        background.wake_at(host, at_millis: 0);
    }
    var why = alloc.String.init(a);
    if not host_api.storage_set(host, key: "alarm", value: kept.view(), why: &mut why, a: a) {
        host_api.log(host, msg: why.view());
    }
}

/// The alarm's time has come: it rings, or else its notification, and it
/// is off.
fn ring(state: &mut Clock, host: &mut std.Host, now: i64, a: alloc.Allocator) {
    if not state.alarm_on {
        return;
    }
    if not alarm.ring(host, label: "Alarm") {
        var text = alloc.String.init(a);
        hours_minutes(state.alarm_at, out: &mut text);
        _ = notify.post(host, title: "Alarm", text: text.view());
    }
    state.alarm_on = false;
    arm(state, host: host, now: now, a: a);
}

/// The alarm's card as it is: its time, when it rings, and its button;
/// snoozed, until when, and Dismiss.
fn show_alarm(state: &Clock, host: &mut std.Host, local: i64, a: alloc.Allocator) {
    var set = alloc.String.init(a);
    hours_minutes(state.alarm_at, out: &mut set);
    dom.set_text(host, item: state.alarm_set, text: set.view());
    var rings = alloc.String.init(a);
    let until = snoozed_until(host);
    if until >= 0 {
        rings.push_str("Snoozed until ");
        hours_minutes(minute_of(until + host_api.utc_offset(host) as i64 * 60000), out: &mut rings);
        dom.set_text(host, item: state.alarm_go, text: "Dismiss");
    } else if state.alarm_on {
        // As Android says it, the minutes rounded up.
        let minutes = (until_alarm(state, local: local) + 59999) / 60000;
        rings.push_str("Rings in ");
        if minutes >= 60 {
            rings.push_u64((minutes / 60) as u64);
            rings.push_str(" h");
            if minutes % 60 > 0 {
                rings.push_str(" ");
            }
        }
        if minutes % 60 > 0 {
            rings.push_u64((minutes % 60) as u64);
            rings.push_str(" min");
        }
        dom.set_text(host, item: state.alarm_go, text: "Turn off");
    } else {
        rings.push_str("Off");
        dom.set_text(host, item: state.alarm_go, text: "Turn on");
    }
    dom.set_text(host, item: state.alarm_rings, text: rings.view());
}

/// Whether the phone keeps an alarm of the app's, not yet rung.
fn has_next(host: &mut std.Host) -> bool {
    match alarm.next(host) {
        some(_) => { return true; }
        none => { return false; }
    }
}

/// When the phone rings the app's snoozed alarm again, in ms since 1970;
/// -1 when it has none.
fn snoozed_until(host: &mut std.Host) -> i64 {
    match alarm.snoozed(host) {
        some(ms) => { return ms; }
        none => { return -1; }
    }
}

/// Minutes of the day as "07:05".
fn hours_minutes(minutes: i64, out: &mut alloc.String) {
    two(out, n: minutes / 60);
    out.push_str(":");
    two(out, n: minutes % 60);
}

/// The first node under the page that selector finds; 0 for none.
fn first(host: &mut std.Host, selector: str, a: alloc.Allocator) -> u32 {
    let found = dom.query_all(host, scope: dom.root(host), selector: selector, a: a);
    if found.len() == 0 {
        return 0;
    }
    return found.items()[0];
}

/// The key a click on n is: its data-k, or its nearest ancestor's.
fn key_of(host: &mut std.Host, n: u32, a: alloc.Allocator) -> ?alloc.String {
    var at = n;
    var hops: u32 = 0;
    while at != 0 and hops < 8 : (hops += 1) {
        match dom.get_attribute(host, item: at, name: "data-k", a: a) {
            some(k) => { return k; }
            none => { }
        }
        at = dom.parent(host, item: at) orelse 0;
    }
    return none;
}

/// What the stopwatch shows at now, in ms.
fn counted(state: &Clock, now: i64) -> i64 {
    if state.running {
        return state.counted + now - state.since;
    }
    return state.counted;
}

fn update(state: &mut Clock, host: &mut std.Host, a: alloc.Allocator) {
    let now = host_api.now_millis(host);
    if background.woken(host) {
        ring(state, host: host, now: now, a: a);
    }
    // The phone rang the alarm it kept, the app running or not: it is off.
    if state.alarm_on and state.by_phone and not has_next(host) {
        state.alarm_on = false;
        arm(state, host: host, now: now, a: a);
    }
    for e in dom.events(host, a: a).items() {
        if e.kind.view().eq("click") {
            match key_of(host, n: e.target, a: a) {
                some(k) => { press(state, host: host, key: k.view(), now: now, a: a); }
                none => { }
            }
        }
    }
    // The time as the user reads it.
    let offset = host_api.utc_offset(host) as i64;
    let local = now + offset * 60000;
    var time = alloc.String.init(a);
    clock_text(local, out: &mut time);
    dom.set_text(host, item: state.time, text: time.view());
    var date = alloc.String.init(a);
    date_text(local, out: &mut date);
    dom.set_text(host, item: state.date, text: date.view());
    var zone = alloc.String.init(a);
    let name = host_api.time_zone(host, a: a);
    if name.len() > 0 {
        zone.push_str(name.view());
        zone.push_str(" · ");
    }
    zone.push_str("UTC");
    if offset < 0 {
        zone.push_str("−");
    } else {
        zone.push_str("+");
    }
    var off = offset;
    if off < 0 {
        off = 0 - off;
    }
    two(&mut zone, n: off / 60);
    zone.push_str(":");
    two(&mut zone, n: off % 60);
    dom.set_text(host, item: state.zone, text: zone.view());
    show_alarm(state, host: host, local: local, a: a);
    // The stopwatch, and its laps not shown yet.
    var shown = alloc.String.init(a);
    watch_text(counted(state, now: now), out: &mut shown);
    dom.set_text(host, item: state.elapsed, text: shown.view());
    while state.laps_shown < state.laps.len() {
        let k = state.laps_shown;
        var line = alloc.String.from("Lap ", a);
        line.push_u64((k + 1) as u64);
        line.push_str("   ");
        var previous: i64 = 0;
        if k > 0 {
            previous = state.laps.items()[k - 1];
        }
        watch_text(state.laps.items()[k] - previous, out: &mut line);
        line.push_str("   ");
        watch_text(state.laps.items()[k], out: &mut line);
        let row = dom.create_element(host, tag: "div");
        dom.set_attribute(host, item: row, name: "class", value_: "lap");
        dom.set_text(host, item: row, text: line.view());
        dom.append_child(host, parent_: state.lap_list, child: row);
        state.laps_shown += 1;
    }
    // The next frame: in a tenth of a second while it runs; else as the
    // second turns.
    if state.running {
        host_api.request_frame(host, after_ms: 100);
    } else {
        host_api.request_frame(host, after_ms: (1000 - local % 1000) as u32);
    }
}

fn press(state: &mut Clock, host: &mut std.Host, key: str, now: i64, a: alloc.Allocator) {
    if key.eq("go") {
        if state.running {
            state.counted = counted(state, now: now);
            state.running = false;
            dom.set_text(host, item: state.go, text: "Start");
        } else {
            state.since = now;
            state.running = true;
            dom.set_text(host, item: state.go, text: "Stop");
        }
    } else if key.eq("lap") {
        if state.running {
            state.laps.push(counted(state, now: now));
        }
    } else if key.eq("alarm") {
        if snoozed_until(host) >= 0 {
            // Snoozed: Dismiss.
            alarm.dismiss(host);
        } else {
            state.alarm_on = not state.alarm_on;
            arm(state, host: host, now: now, a: a);
        }
    } else if key.eq("h+") or key.eq("h-") or key.eq("m+") or key.eq("m-") {
        var step: i64 = 1;
        if key.starts_with("h") {
            step = 60;
        }
        if key.bytes()[1] == '-' {
            step = DAY_MINUTES - step;
        }
        state.alarm_at = (state.alarm_at + step) % DAY_MINUTES;
        arm(state, host: host, now: now, a: a);
    } else if key.eq("reset") {
        if not state.running {
            state.counted = 0;
            state.laps = alloc.List(i64).init(a);
            state.laps_shown = 0;
            // The lap rows go with them.
            for row in dom.children(host, item: state.lap_list, a: a).items() {
                dom.release(host, item: row.*);
            }
        }
    }
}

fn two(s: &mut alloc.String, n: i64) {
    if n < 10 {
        s.push_str("0");
    }
    s.push_u64(n as u64);
}

/// Hours, minutes and seconds of local, ms since 1970 as the user's
/// clock reads.
fn clock_text(local: i64, out: &mut alloc.String) {
    var seconds = (local / 1000) % 86400;
    if seconds < 0 {
        seconds += 86400;
    }
    two(out, n: seconds / 3600);
    out.push_str(":");
    two(out, n: (seconds / 60) % 60);
    out.push_str(":");
    two(out, n: seconds % 60);
}

/// The n-th word of words, from 0.
fn nth_word(words: str, n: i64) -> str {
    let b = words.bytes();
    var at: usize = 0;
    var k: i64 = 0;
    while at < b.len() {
        var e = at;
        while e < b.len() and b[e] != ' ' {
            e += 1;
        }
        if k == n {
            return words[at..e];
        }
        k += 1;
        at = e + 1;
    }
    return "";
}

/// The day of local: "Tuesday, November 10".
fn date_text(local: i64, out: &mut alloc.String) {
    var days = local / 86400000;
    if local < 0 and local % 86400000 != 0 {
        days -= 1;
    }
    // The civil date from the days since 1970 (Howard Hinnant's
    // civil_from_days).
    let z = days + 719468;
    var era = z / 146097;
    if z < 0 {
        era = (z - 146096) / 146097;
    }
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let day = doy - (153 * mp + 2) / 5 + 1;
    var month = mp + 3;
    if mp >= 10 {
        month = mp - 9;
    }
    // 1970-01-01 was a Thursday.
    var weekday = days % 7;
    if weekday < 0 {
        weekday += 7;
    }
    out.push_str(nth_word("Thursday Friday Saturday Sunday Monday Tuesday Wednesday", n: weekday));
    out.push_str(", ");
    out.push_str(nth_word("January February March April May June July August September October November December", n: month - 1));
    out.push_str(" ");
    out.push_u64(day as u64);
}

/// A stopwatch's ms as minutes, seconds and tenths: "01:23.4".
fn watch_text(ms: i64, out: &mut alloc.String) {
    var m = ms;
    if m < 0 {
        m = 0;
    }
    two(out, n: m / 60000);
    out.push_str(":");
    two(out, n: (m / 1000) % 60);
    out.push_str(".");
    out.push_u64(((m / 100) % 10) as u64);
}
